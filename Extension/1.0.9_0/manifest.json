{
   "action": {
      "default_popup": "popup.html",
      "default_title": "HaramMute"
   },
   "author": "md.alganzory@gmail.com",
   "background": {
      "service_worker": "dist/background.bundle.js"
   },
   "content_scripts": [ {
      "js": [ "soundtouch.js", "dist/posthog-content-bundle.js", "dist/content.bundle.js" ],
      "matches": [ "https://www.youtube.com/*" ]
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com https://api.haram-mute.com http://127.0.0.1:8765 http://127.0.0.1:8766 http://127.0.0.1:8767 http://127.0.0.1:8768;"
   },
   "description": "Remove background music from videos with one click. Keep the dialogue, lose the music.",
   "host_permissions": [ "http://127.0.0.1:8765/*", "http://127.0.0.1:8766/*", "http://127.0.0.1:8767/*", "http://127.0.0.1:8768/*", "http://localhost:8765/*", "http://localhost:8766/*", "http://localhost:8767/*", "http://localhost:8768/*" ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "HaramMute - Remove Background Music from YouTube Videos",
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.9",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "dist/posthog-content-bundle.js", "ding.wav", "icon.png", "icon16.png", "icon48.png", "icon128.png", "icon_loading.gif" ]
   } ]
}
