{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HaramLite",
  "version": "0.2.5",
  "identifier": "com.harammute.haramlite",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HaramLite",
        "width": 1100,
        "height": 800,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": []
        }
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; media-src 'self' asset: http://asset.localhost"
    }
  },
  "plugins": {
    "updater": {
      "active": false,      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMUY4RERGREVBNjZERDUKUldUVmJhYmUzNDBmYlg4eVBsak1RdHFzc1JxdTVvMVdCbEQ2dS8rdjQvcTRCcWxMems4ZEZxNjcK",
      "endpoints": [
        "https://github.com/SMSMy/HaramLite/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin": "bin",
      "../models": "models",
      "../licenses": "licenses",
      "vc_redist.x64.exe": "."
    },
    "windows": {
      "nsis": {
        "installerHooks": "hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
