{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the independent settings window",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "dialog:default",
    "notification:default",
    "updater:default"
  ]
}
