{
  "name": "haramlite-rs",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "tailwindcss -c ./tailwind.config.cjs -i ./src/input.css -o ./src/tailwind.css --minify",
    "dev": "vite",
    "build": "node ./scripts/fetch_redist.js && tailwindcss -c ./tailwind.config.cjs -i ./src/input.css -o ./src/tailwind.css --minify && tsc && vite build",
    "build:css": "tailwindcss -c ./tailwind.config.cjs -i ./src/input.css -o ./src/tailwind.css --minify",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.11.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tauri-apps/cli": "^2",
    "tailwindcss": "3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
