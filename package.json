{
  "name": "haramlite-rs",
  "private": true,
  "version": "0.2.8",
  "type": "module",
  "scripts": {
    "predev": "tailwindcss -c ./tailwind.config.cjs -i ./src/input.css -o ./src/tailwind.css --minify",
    "dev": "vite",
    "build": "node ./scripts/fetch_redist.js && tailwindcss -c ./tailwind.config.cjs -i ./src/input.css -o ./src/tailwind.css --minify && tsc && vite build",
    "build:css": "tailwindcss -c ./tailwind.config.cjs -i ./src/input.css -o ./src/tailwind.css --minify",
    "build:web": "pnpm run build:css && vite build",
    "test:web": "vitest run",
    "site:css": "tailwindcss -c ./site.tailwind.config.cjs -i ./site.input.css -o ./docs/assets/site.css --minify",
    "preview": "vite preview",
    "pack:ext": "node ./scripts/pack-extension.js --target chrome",
    "pack:ext:firefox": "node ./scripts/pack-extension.js --target firefox",
    "tauri": "tauri",
    "e2e:release": "pwsh -NoProfile -Command \"Set-Location src-tauri; cargo test --lib e2e_separation_is_measurable_on_generated_sample -- --nocapture; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; cargo test --lib e2e_full_pipeline_through_ffmpeg -- --ignored --nocapture\"",
    "settings:parity": "node scripts/check-settings-parity.cjs",
    "build:info": "node scripts/build-info.cjs",
    "fetch:resources": "node scripts/fetch-resources.cjs",
    "verify:resources": "node scripts/fetch-resources.cjs --verify-only",
    "versions:check": "node scripts/verify-versions.cjs",
    "ext:guard": "node scripts/check-extension-sync.cjs && node scripts/check-css-toplevel.cjs && node scripts/check-extension-i18n.cjs",
    "ext:mutants": "node scripts/check-extension-mutants.cjs && node scripts/check-extension-i18n-mutants.cjs",
    "ext:i18n": "node scripts/check-extension-i18n.cjs",
    "site:check": "node scripts/check-site-css.cjs && node scripts/check-site-pages.cjs && node scripts/check-site-tags.cjs && node scripts/check-site-arabic.cjs && node scripts/check-site-links.cjs && node scripts/site-footer-and-icon-buttons.cjs --check",
    "matrix:check": "node scripts/matrix-check.cjs",
    "separation:entry": "node scripts/check-separation-entry.cjs",
    "cuda:guard": "node scripts/check-cuda-assets.cjs",
    "release:assets": "node scripts/check-release-assets.cjs",
    "redist:guard": "node scripts/check-fetch-redist.cjs",
    "release:parity": "node scripts/check-release-parity.cjs",
    "guards:selfcheck": "node scripts/check-guards-selfcheck.cjs",
    "release:verify": "node scripts/check-release-artifact.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.11.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tauri-apps/cli": "^2",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "3.4.19",
    "typescript": "~5.9.3",
    "vite": "^6.0.3",
    "vitest": "^5.0.1"
  }
}

